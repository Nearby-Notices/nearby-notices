# Copy to .env and export, or set in the environment. All optional; the defaults run against a local model server.

# Model, in LiteLLM's naming. Leave NN_MODEL unset with a local OpenAI-compatible server (llama-server, Ollama): the
# served model's name is read from the server at startup and recorded with every plain-English version.
# NN_MODEL=openai/local
NN_MODEL_API_BASE=http://127.0.0.1:8696/v1
NN_MODEL_API_KEY=local
# A cloud model instead, for example: NN_MODEL=anthropic/claude-haiku-5-5  NN_MODEL_API_KEY=...  (unset NN_MODEL_API_BASE)

NN_DAILY_CALL_CAP=2000          # model calls a day, then the page shows notices verbatim only
NN_DB_PATH=data/notices.sqlite  # notices, plain-English versions, counters; nothing a user typed
NN_USER_AGENT=NearbyNotices/0.1 (open-source civic tool; contact via the repository)
NN_DEFAULT_DISTANCE=3           # miles, on the home page
NN_MAX_RESULTS=12
NN_FEED_CACHE_SECONDS=3600
